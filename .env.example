# Database (required on Vercel — Neon via Vercel Storage sets POSTGRES_URL_* automatically)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"
# Vercel Neon also provides: POSTGRES_URL, POSTGRES_URL_NO_SSL, POSTGRES_URL_NON_POOLING

# Local dev: npm run db:local:up then use:
# DATABASE_URL="postgresql://codespace:codespace@127.0.0.1:5433/msgnexus"
USE_NEON=false
NEON_DATABASE_URL=""

# App URL (production — used for magic links & OAuth callbacks)
# In GitHub Codespaces this is auto-detected via CODESPACE_NAME + GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN
# Use your canonical production URL (include www if that's what users visit)
NEXT_PUBLIC_APP_URL="https://www.msgnexus.ai"

# Magic link email (required in production)
RESEND_API_KEY=""
# Required in production — must use a verified domain (not @resend.dev)
RESEND_FROM_EMAIL="MsgNexus.AI <onboarding@msgnexus.ai>"
# Local dev only: show magic link on screen when RESEND_API_KEY is unset
ALLOW_DEV_MAGIC_LINK="false"

# Gmail OAuth (optional — enables real email import in Settings)
# redirect_uri is NOT an env var — the app builds it as:
#   {NEXT_PUBLIC_APP_URL}/api/auth/gmail/callback
# (or the request host / Codespace URL when NEXT_PUBLIC_APP_URL is unset)
#
# Google Cloud Console → Credentials → your Web application OAuth client
# (must be the same client as GOOGLE_CLIENT_ID). Add Authorized redirect URIs:
#   https://www.msgnexus.ai/api/auth/gmail/callback
#   https://msgnexus.ai/api/auth/gmail/callbackl.
#   http://localhost:3000/api/auth/gmail/callback
#   https://<CODESPACE_NAME>-3000.app.github.dev/api/auth/gmail/callback
# Also add matching Authorized JavaScript origins (origin only, no path).
# Save, wait 1–2 minutes. Error 400 redirect_uri_mismatch = URI missing above.
# Confirm live values: GET /api/auth/oauth-info
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Legacy typo fallback still supported by the app if you already set it on Vercel:
# GOOGLE_CLIENT_SECRETE=""

# Microsoft / Outlook OAuth (optional — Settings → Connect Outlook)
# Azure Portal → App registration → Authentication → Web redirect URIs:
#   https://www.msgnexus.ai/api/auth/microsoft/callback
#   https://msgnexus.ai/api/auth/microsoft/callback
# Account types: any org directory + personal Microsoft accounts
# API permissions (delegated): Mail.Read, User.Read, offline_access, openid, profile, email
# MICROSOFT_TENANT_ID=common (default) | consumers (personal only) | your-tenant-id
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Twilio SMS (optional — Settings connect + /api/webhooks/twilio)
# TWILIO_PHONE_NUMBER must be the Twilio number that owns the SMS history (E.164).
# Twilio Console → Phone Numbers → your number → “A message comes in” webhook:
#   https://www.msgnexus.ai/api/webhooks/twilio  (HTTP POST)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Auto-reply to inbound SMS with TwiML (set TWILIO_AUTO_REPLY=true or custom message below)
TWILIO_AUTO_REPLY="false"
TWILIO_AUTO_REPLY_MESSAGE="Got it! This message is now in MsgNexus."

# Slack OAuth
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# Discord OAuth
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# WhatsApp Business (Meta Cloud API)
# No history list API — inbound only via webhook after Connect in Settings.
# Meta Developer → WhatsApp → Configuration:
#   Callback URL: https://www.msgnexus.ai/api/webhooks/whatsapp
#   Verify token: same as WHATSAPP_VERIFY_TOKEN
#   Subscribe: messages
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# X / Twitter OAuth 2.0
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Vercel Cron auth (optional — secures /api/cron/sync)
CRON_SECRET=""

# Admin portal (comma-separated emails auto-promoted to admin on login; required in production)
ADMIN_EMAILS=""

# Stripe billing (optional — enables Pro/Enterprise checkout in Settings)
# 1. Create Products + recurring Prices in Stripe Dashboard → Product catalog
# 2. Webhook endpoint: https://www.msgnexus.ai/api/webhooks/stripe
#    Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

# UserLens tester service (optional — UX/a11y/performance scans from Admin → /admin/userlens)
# Start locally: cd userlens-tester && npm install && npx playwright install chromium && npm run dev -- -p 3001
USERLENS_SERVICE_URL="http://localhost:3001"