# =============================================================================
# MsgNexus.AI — environment variables
# Copy to .env.local for local dev. On Vercel, set the same keys in Project → Settings → Environment Variables.
# Search / AI parser / re-analyze need no extra keys (local deterministic).
# =============================================================================

# --- Required (core app) -------------------------------------------------------

# Postgres (required in production). Vercel Neon Storage may set POSTGRES_* instead.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"
# Also accepted (first non-empty wins): POSTGRES_URL, POSTGRES_URL_NON_POOLING,
# POSTGRES_URL_NO_SSL, POSTGRES_PRISMA_URL, NEON_DATABASE_URL

# Local Docker Postgres: npm run db:local:up
# DATABASE_URL="postgresql://codespace:codespace@127.0.0.1:5433/msgnexus"
USE_NEON=false
NEON_DATABASE_URL=""

# Canonical public URL (magic links, OAuth redirects, Stripe return URLs)
# Codespaces: auto-detected via CODESPACE_NAME when unset
NEXT_PUBLIC_APP_URL="https://www.msgnexus.ai"

# Magic-link email (required in production)
RESEND_API_KEY=""
# Must use a verified domain (not @resend.dev) in production
RESEND_FROM_EMAIL="MsgNexus.AI <onboarding@msgnexus.ai>"
# Local only: show magic link on screen when Resend is unset
ALLOW_DEV_MAGIC_LINK="false"

# Comma-separated emails promoted to admin on login (required in production)
ADMIN_EMAILS=""

# --- Optional: Web Push (browser notifications) --------------------------------
# Generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:onboarding@msgnexus.ai"

# --- Optional: Gmail OAuth -----------------------------------------------------
# redirect_uri is built as {NEXT_PUBLIC_APP_URL}/api/auth/gmail/callback
# Google Cloud Console → OAuth client → Authorized redirect URIs:
#   https://www.msgnexus.ai/api/auth/gmail/callback
#   https://msgnexus.ai/api/auth/gmail/callback
#   http://localhost:3000/api/auth/gmail/callback
# Confirm live values: GET /api/auth/oauth-info
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Legacy typo fallback (if already set on Vercel): GOOGLE_CLIENT_SECRETE

# --- Optional: Microsoft / Outlook OAuth ---------------------------------------
# Azure → App registration → Web redirect:
#   https://www.msgnexus.ai/api/auth/microsoft/callback
# Permissions: Mail.Read, User.Read, offline_access, openid, profile, email
# MICROSOFT_TENANT_ID=common | consumers | <tenant-id>
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# --- Optional: Twilio SMS ------------------------------------------------------
# Webhook: POST {APP_URL}/api/webhooks/twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_AUTO_REPLY="false"
TWILIO_AUTO_REPLY_MESSAGE="Got it! This message is now in MsgNexus."

# --- Optional: Slack OAuth -----------------------------------------------------
# Callback: {APP_URL}/api/auth/slack/callback
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# --- Optional: Discord OAuth ---------------------------------------------------
# Callback: {APP_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# --- Optional: Telegram Bot ----------------------------------------------------
# Webhook: {APP_URL}/api/webhooks/telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# --- Optional: WhatsApp Business (Meta Cloud API) ------------------------------
# Callback: {APP_URL}/api/webhooks/whatsapp  Verify token = WHATSAPP_VERIFY_TOKEN
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# --- Optional: X / Twitter OAuth 2.0 -------------------------------------------
# Callback: {APP_URL}/api/auth/x/callback
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# --- Optional: Stripe billing --------------------------------------------------
# Webhook: {APP_URL}/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

# --- Optional: Cron + ops ------------------------------------------------------
# Authorizes /api/cron/sync (Vercel Cron)
CRON_SECRET=""

# UserLens tester (Admin → /admin/userlens)
# Local: cd userlens-tester && npm i && npx playwright install chromium && npm run dev -- -p 3001
USERLENS_SERVICE_URL="http://localhost:3001"
# Alternate (same purpose): NEXT_PUBLIC_USERLENS_SERVICE_URL

# E2E smoke script only: APP_URL=http://localhost:3000
